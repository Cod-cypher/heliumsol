# Copy to .env and fill in. .env is gitignored; production reads
# /opt/heliumsol/.env on the server.

# Postgres. HeliumSol has its own "heliumsol" database on the same Postgres
# instance as optimizeindex. On the server use localhost.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/heliumsol?schema=public"

# Port the Node server listens on. Production: 3003 (nginx proxies to it).
PORT=3003

# Signs admin session cookies and chat join links. 32+ random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Outbound mail (lead notifications and chat handoff emails)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@heliumsol.com
SMTP_PASS=
MAIL_FROM=info@heliumsol.com
# GoDaddy Workspace mail: smtpout.secureserver.net, port 465, log in as the mailbox.
# Where lead notifications go. Must be a mailbox that accepts mail.
LEAD_NOTIFY_EMAIL=info@heliumsol.com

# Chat assistant. With no key the widget falls back to a contact form.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
CHAT_ENABLED=true
# Receives "someone started a chat" and handoff emails with the join link.
CHAT_HANDOFF_EMAIL=info@heliumsol.com
# Name shown on messages from the team's side.
CHAT_AGENT_LABEL=HeliumSol
# Backstop against a runaway OpenAI bill: tokens per calendar month.
CHAT_MONTHLY_TOKEN_CAP=5000000
CHAT_MAX_TURNS=25
# Minutes before a visitor can ask for a person again in the same chat.
# Also capped at 3 an hour and 6 a day per visitor.
CHAT_HANDOFF_COOLDOWN_MINUTES=10
# Base URL for join links. Production defaults to https://heliumsol.com.
PUBLIC_ORIGIN=
