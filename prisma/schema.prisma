generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What the visitor submitted
  type       String // general_enquiry | chat_widget
  name       String?
  email      String
  phone      String?
  company    String?
  website    String
  competitor String?
  goal       String? // revenue | profit | conversions | cac | roi
  service    String? // gmb | seo | aeo | geo | paid-search | ...
  budget     String?
  comments   String?

  // Marketing attribution — mirrors what we sell: channel-level ROI tracking
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  referrer      String?
  landingPage   String? // first page of the session
  submittedFrom String? // page the form was submitted on
  gaClientId    String? // GA4 client id for cross-referencing analytics

  // Journey linkage — join to Visitor/Session/PageView/Event for the full
  // pre-conversion story (pages viewed, time on site, sessions to convert)
  visitorId String?
  sessionId String?
  // The instant audit this lead came out of, when it came from the hero tool
  auditId   String?

  // Technical context
  userAgent String?
  ipAddress String?

  // Delivery + sales pipeline for business analysis
  emailForwarded Boolean    @default(false)
  status         LeadStatus @default(NEW)
  followUpNotes  String?

  @@index([email])
  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@index([utmSource, utmMedium, utmCampaign])
  @@index([visitorId])
  @@index([sessionId])
  @@index([auditId])
}

// One row per unique browser (anonymous id persisted in localStorage).
// First-touch attribution lives here; answers "which channel creates
// visitors that eventually convert, even weeks later?"
model Visitor {
  id          String   @id // client-generated
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  firstReferrer    String?
  firstLandingPage String?
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?

  deviceType String? // mobile | tablet | desktop
  browser    String?
  os         String?
  language   String?
  timezone   String?
  country    String?

  sessionCount Int       @default(1)
  convertedAt  DateTime? // set on first lead submission
  leadEmail    String? // ties anonymous history to the identified lead

  @@index([firstSeenAt])
  @@index([convertedAt])
  @@index([firstUtmSource, firstUtmMedium, firstUtmCampaign])
}

// One row per visit (30-minute inactivity window). Duration is
// lastActivityAt - startedAt; bounce = pageViewCount 1 and no events.
model Session {
  id             String   @id // client-generated
  visitorId      String
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  entryPage String?
  exitPage  String?
  referrer  String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  deviceType   String?
  browser      String?
  os           String?
  screenWidth  Int?
  screenHeight Int?
  language     String?
  timezone     String?
  country      String?
  ipAddress    String?
  userAgent    String?

  pageViewCount Int     @default(0)
  eventCount    Int     @default(0)
  isConverted   Boolean @default(false) // a lead was submitted this session

  @@index([visitorId])
  @@index([startedAt])
  @@index([isConverted])
  @@index([utmSource, utmMedium, utmCampaign])
}

// One row per page seen, with engagement quality (time + scroll depth).
model PageView {
  id        String   @id // client-generated so duration/scroll update the same row
  sessionId String
  visitorId String
  path      String
  title     String?
  startedAt DateTime @default(now())

  durationMs   Int? // filled in when the visitor leaves the page
  maxScrollPct Int? // deepest scroll reached, 0-100

  @@index([sessionId])
  @@index([visitorId])
  @@index([path])
  @@index([startedAt])
}

// Every meaningful interaction: CTA clicks (by element id), goal-pill
// selections, phone/email taps, form starts, form submissions, outbound
// clicks. `name` is the event type, `label` the specific target.
model Event {
  id        String   @id @default(cuid())
  sessionId String
  visitorId String
  createdAt DateTime @default(now())

  name     String // click | phone_click | email_click | outbound_click | form_start | form_submit | form_error | goal_selected | session_start
  label    String? // element id, href, goal id, form name...
  path     String? // page where it happened
  metadata Json? // free-form extras (link text, href, etc.)

  @@index([sessionId])
  @@index([visitorId])
  @@index([name, createdAt])
  @@index([createdAt])
}

/**
 * ---------------------------------------------------------------------------
 * Admin
 * ---------------------------------------------------------------------------
 */

/// Staff login. A table rather than a password in .env, so the password can be
/// rotated and a second seat added without a redeploy.
/// Seed with: npm run admin -- <email> <password>
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// scrypt, stored as "<saltHex>:<derivedKeyHex>". See server/auth.ts.
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  isActive     Boolean   @default(true)
}

/// Lifecycle of a chat conversation.
///
/// HANDOFF_PENDING is deliberately distinct from LIVE: the bot keeps answering
/// while the handoff email sits unread, because a visitor who waits in silence leaves.
/// LIVE mutes the bot — two voices answering one question is worse than a pause.
enum ChatStatus {
  ACTIVE
  HANDOFF_PENDING
  LIVE
  CLOSED
}

enum ChatRole {
  VISITOR
  ASSISTANT
  AGENT
  SYSTEM
}

/// One conversation in the site's chat widget.
///
/// A row is written the moment the widget is opened, before any model call, so
/// an abandoned "hi" costs one row and no money. The domains and questions
/// people bring here are lead intelligence in their own right, the same
/// reasoning that makes SiteAudit worth writing for visitors who never convert.
///
/// Named ChatConversation, never ChatSession: `Session` in this schema is the
/// analytics visit model, and a second thing called a session in the same
/// namespace is a bug waiting to be written.
model ChatConversation {
  id            String     @id @default(cuid())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastMessageAt DateTime   @default(now())
  status        ChatStatus @default(ACTIVE)

  // Journey linkage, from src/lib/tracker.ts (hs_vid / hs_sid). Deliberately
  // not foreign keys: the Visitor row may never exist if an ad blocker ate the
  // analytics beacon, and a chat must not fail because of that.
  visitorId  String?
  sessionId  String?
  gaClientId String?

  startedOn String? // path the widget was opened on
  referrer  String?
  userAgent String?
  ipAddress String?
  country   String?

  // What the assistant extracted during the conversation. Held here rather than
  // on Lead because it is partial until capture_lead fires — a name with no
  // email yet is not a lead, but it is worth keeping.
  visitorName     String?
  visitorEmail    String?
  visitorPhone    String?
  visitorCompany  String?
  visitorWebsite  String?
  /// Where they operate, in their own words — "Austin", "north Georgia",
  /// "nationwide". Free text rather than a structured location because that is
  /// how people answer the question, and a service area is the fact that
  /// decides whether we can help before anything else about them matters.
  visitorArea     String?
  qualified       Boolean @default(false)
  qualifiedReason String?

  /// When the "someone started a chat" email went out. Deliberately separate
  /// from handoffEmailSentAt: that one is debounced, and a visitor who later
  /// actually asks for a person must not have their request swallowed because
  /// an opening notification happened to go out four minutes earlier.
  startedEmailSentAt DateTime?

  /// When the "they came back" email last went out. A conversation now survives
  /// the browser tab, so the same thread can go quiet for days and then resume;
  /// startedEmailSentAt can only ever fire once, so without this a return visit
  /// would reach nobody. Re-armed after RESUMED_GAP_MS rather than once per
  /// conversation, because a visitor can come back more than once.
  resumedEmailSentAt DateTime?

  /// When the "they left before you got there" email went out. Once per
  /// conversation: the point is that a moment was missed, and saying so twice
  /// does not un-miss it.
  visitorLeftEmailSentAt DateTime?

  // Human handoff
  handoffRequestedAt DateTime?
  handoffReason      String? // visitor_asked | qualified_lead | out_of_scope | complaint | pricing
  handoffEmailSentAt DateTime?
  agentJoinedAt      DateTime?
  agentLabel         String?

  /// Nonce embedded in the emailed join link. Nulling it revokes every
  /// outstanding link for this conversation without rotating SESSION_SECRET
  /// (which would also sign every admin out).
  agentTokenId        String?   @unique
  agentTokenExpiresAt DateTime?
  agentFirstSeenAt    DateTime?
  agentIpAddress      String?

  /// Set when capture_lead fired. Lead is the pipeline record; this is the join
  /// back to the transcript that produced it.
  leadId String?
  /// Set when run_site_audit fired, joining to the SiteAudit row.
  auditId String?

  closedAt     DateTime?
  closedReason String?

  // Cost accounting. Summed per calendar month against CHAT_MONTHLY_TOKEN_CAP,
  // which is the backstop against a runaway bill.
  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  turnCount        Int @default(0)

  messages ChatMessage[]

  @@index([status, lastMessageAt])
  @@index([visitorId])
  @@index([createdAt])
}

/// One message in a conversation, from the visitor, the model, a team member, or the
/// system ("HeliumSol joined the conversation").
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  /// Polling cursor. GLOBAL and monotonic rather than per-conversation, because
  /// a per-conversation counter is a read-modify-write and two writers race here
  /// routinely — the model's reply lands while a team member is typing. Postgres owns the
  /// sequence, so neither writer has to coordinate. Monotonic globally implies
  /// monotonic within a conversation, which is all the cursor needs.
  seq Int @unique @default(autoincrement())

  role    ChatRole
  content String
  /// message | notice. A notice renders as centred grey text, not a bubble.
  kind    String   @default("message")
  /// What the bubble is labelled with — "HeliumSol".
  authorLabel String?

  // Set on the assistant turn that triggered a tool. Kept for debugging what
  // the model actually asked for when a lead looks wrong.
  toolName String?
  toolArgs Json?

  /// Grounding and context rows the model sees but the visitor never does.
  hidden Boolean @default(false)

  @@index([conversationId, seq])
}
